///|
fn assert_reasons(
  kind : ReasonPacketKind,
  direction : PacketDirection,
  expected : Array[Int],
) -> Unit raise {
  for code in 0..<256 {
    assert_eq(reason_allowed(kind, direction, code), expected.contains(code))
  }
}

///|
test "C-T03 MQTT5 reason code whitelist matches packet and direction" {
  let connack = [
    0x00, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8a, 0x8c,
    0x90, 0x95, 0x97, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9f,
  ]
  assert_reasons(ConnackReason, ServerToClient, connack)
  assert_reasons(ConnackReason, ClientToServer, [])
  let ack = [0x00, 0x80, 0x83, 0x87, 0x90, 0x91, 0x97, 0x99]
  for kind in [ReasonPacketKind::PubackReason, PubrecReason] {
    assert_reasons(kind, ClientToServer, ack)
    assert_reasons(kind, ServerToClient, [0x10, ..ack])
  }
  for kind in [ReasonPacketKind::PubrelReason, PubcompReason] {
    assert_reasons(kind, ClientToServer, [0x00, 0x92])
    assert_reasons(kind, ServerToClient, [0x00, 0x92])
  }
  assert_reasons(SubackReason, ServerToClient, [
    0x00, 0x01, 0x02, 0x80, 0x83, 0x87, 0x8f, 0x91, 0x97, 0x9e, 0xa1, 0xa2,
  ])
  assert_reasons(SubackReason, ClientToServer, [])
  assert_reasons(UnsubackReason, ServerToClient, [
    0x00, 0x11, 0x80, 0x83, 0x87, 0x8f, 0x91,
  ])
  assert_reasons(UnsubackReason, ClientToServer, [])
  assert_reasons(AuthReason, ClientToServer, [0x18, 0x19])
  assert_reasons(AuthReason, ServerToClient, [0x00, 0x18])
  let disconnect_client = [
    0x00, 0x04, 0x80, 0x81, 0x82, 0x83, 0x90, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98,
    0x99,
  ]
  assert_reasons(DisconnectReason, ClientToServer, disconnect_client)
  assert_reasons(DisconnectReason, ServerToClient, [
    0x00, 0x80, 0x81, 0x82, 0x83, 0x87, 0x89, 0x8b, 0x8d, 0x8e, 0x8f, 0x90, 0x93,
    0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f, 0xa0,
    0xa1, 0xa2,
  ])
}
