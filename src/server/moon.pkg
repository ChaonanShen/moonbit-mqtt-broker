import {
  "moonbitlang/core/deque",
  "ChaonanShen/moonbit-mqtt-broker/resource_budget" @budget,
  "moonbitlang/async",
  "ChaonanShen/moonbit-mqtt-broker/framing",
  "ChaonanShen/moonbit-mqtt-broker/protocol_adapter" @protocol,
  "ChaonanShen/moonbit-mqtt-broker/persistence",
  "ChaonanShen/moonbit-mqtt-broker/router",
  "ChaonanShen/moonbit-mqtt-broker/session",
  "ChaonanShen/moonbit-mqtt-broker/slot_index",
  "ChaonanShen/moonbit-mqtt-broker/security",
  "ChaonanShen/moonbit-mqtt-broker/reload_bundle" @bundle,
  "ChaonanShen/moonbit-mqtt-broker/reload_native" @native,
  "ChaonanShen/moonbit-mqtt-broker/config",
  "ChaonanShen/moonbit-mqtt-broker/topic",
  "ChaonanShen/moonbit-mqtt-broker/observability",
  "ChaonanShen/moonbit-mqtt-broker/management",
  "ChaonanShen/moonbit-mqtt-broker/http_transport",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/async/io",
  "moonbitlang/async/pipe",
  "moonbitlang/async/socket",
  "moonbitlang/async/tls",
  "moonbitlang/core/encoding/utf8",
}

// `moonbitlang/async` exposes its server-side TLS constructors as experimental
// internal APIs. The broker pins the dependency and covers both call sites
// with TLS startup, rejection, interoperability, concurrency, and restart tests.

warnings = "-alert_internal"

import {
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
} for "wbtest"

import {
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
} for "test"

options(
  "native-stub": [
    "websocket_native.c",
    "tls_material_native.c",
    "mqtt5_identity_native.c",
  ],
  targets: {
    "connection_server.mbt": [ "native" ],
    "websocket_native.mbt": [ "native" ],
    "mqtt5_identity_native.mbt": [ "native" ],
    "mqtt5_identity_native_test.mbt": [ "native" ],
    "tls_material_native.mbt": [ "native" ],
    "reload_tls_prepare.mbt": [ "native" ],
    "reload_prepare.mbt": [ "native" ],
    "config_generation.mbt": [ "native" ],
    "reload_activation.mbt": [ "native" ],
    "reload_driver_event.mbt": [ "native" ],
    "reload_coordinator.mbt": [ "native" ],
    "reload_service.mbt": [ "native" ],
    "reload_service_wbtest.mbt": [ "native" ],
    "reload_management_wbtest.mbt": [ "native" ],
    "reload_http_network_wbtest.mbt": [ "native" ],
    "reload_policy_commit_wbtest.mbt": [ "native" ],
    "reload_signal_network_wbtest.mbt": [ "native" ],
    "reload_ticker_wbtest.mbt": [ "native" ],
    "reload_prepare_wbtest.mbt": [ "native" ],
    "reload_auth_reservation_wbtest.mbt": [ "native" ],
    "reload_reconcile_driver_wbtest.mbt": [ "native" ],
    "reload_reconcile_strict_driver_wbtest.mbt": [ "native" ],
    "reload_tls_prepare_wbtest.mbt": [ "native" ],
    "websocket_native_test.mbt": [ "native" ],
    "websocket_handshake_test.mbt": [ "native" ],
    "websocket_codec_test.mbt": [ "native" ],
    "websocket_network_test.mbt": [ "native" ],
    "tls_material_native_wbtest.mbt": [ "native" ],
    "tls_material_provider_wbtest.mbt": [ "native" ],
    "policy_epoch_wbtest.mbt": [ "native" ],
    "policy_runtime_reconcile_test.mbt": [ "native" ],
    "policy_strict_reconcile_wbtest.mbt": [ "native" ],
    "reload_strict_bootstrap_wbtest.mbt": [ "native" ],
    "reload_barrier_wbtest.mbt": [ "native" ],
    "reload_runtime_bootstrap_wbtest.mbt": [ "native" ],
    "reload_queue_test.mbt": [ "native" ],
    "websocket_gate_wbtest.mbt": [ "native" ],
    "connection_server_test.mbt": [ "native" ],
    "multi_listener_test.mbt": [ "native" ],
  },
)
